# Copy this file to the ignored `.env` file and replace every password value.
# These values are examples for the self-contained development database only.
COMPOSE_PROJECT_NAME=account-dev-db
ACCOUNT_NETWORK_NAME=account-dev-network
POSTGRES_VOLUME_NAME=account-dev-postgres-data

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_USER=account_admin
POSTGRES_ADMIN_PASSWORD=replace-with-local-admin-password

# Each database receives its own `<database>_owner` login role.
ACCOUNT_DB_PASSWORD=replace-with-local-service-password
ACCOUNT_DATABASES=auth_dev,master_data_dev,internal_audit_dev,journal_ledger_dev,closing_dev,loan_dev,deposit_dev,asset_lease_dev,payable_dev,receivable_dev,reconciliation_dev,tax_dev,expenditure_resolution_dev,reporting_dev,account_mart_dev,ecl_dev

# Used only with: docker compose ... --profile admin up -d pgadmin
PGADMIN_IMAGE=dpage/pgadmin4:8
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace-before-enabling-pgadmin
