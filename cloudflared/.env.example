# Quick mode needs neither this file nor a Cloudflare account.
# Named mode: copy to cloudflared/.env (git-ignored), restrict access, then edit locally.
CLOUDFLARE_TUNNEL_TOKEN=
# Root docker-compose.yml defaults to account-dev-network; match your Nginx network.
ACCOUNT_NETWORK_NAME=account-network
# auto prefers QUIC; use http2 when outbound UDP 7844 is unavailable.
CLOUDFLARE_TUNNEL_PROTOCOL=auto
