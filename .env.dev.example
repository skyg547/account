# Copy to the ignored `.env.dev` file and replace every password/secret.
COMPOSE_PROJECT_NAME=account-dev
ACCOUNT_NETWORK_NAME=account-dev-network
POSTGRES_VOLUME_NAME=account-dev-postgres-data

POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
KAFKA_IMAGE=bitnami/kafka:3.7
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
DEV_GATEWAY_PORT=8000
DEV_FRONTEND_PORT=3000

POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_USER=account_admin
POSTGRES_ADMIN_PASSWORD=replace-with-local-admin-password
ACCOUNT_DB_OWNER_PASSWORD=replace-with-local-owner-password
ACCOUNT_DB_APP_PASSWORD=replace-with-local-app-password
ACCOUNT_DATABASES=auth_dev,master_data_dev,internal_audit_dev,budget_dev,journal_ledger_dev,closing_dev,loan_dev,deposit_dev,asset_lease_dev,payable_dev,receivable_dev,reconciliation_dev,tax_dev,expenditure_resolution_dev,reporting_dev,account_mart_dev,ecl_dev

DEV_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DEV_REDIS_HOST=redis
DEV_REDIS_PORT=6379
NEXT_PUBLIC_API_URL=/api

AUTH_JWT_SECRET=replace-with-local-jwt-secret-at-least-32-characters
AUTH_DEFAULT_PASSWORD=replace-with-local-auth-bootstrap-password
AUTH_INTERNAL_API_TOKEN=replace-with-local-internal-token-at-least-32-characters

ACCOUNT_MART_DB_URL=jdbc:postgresql://postgres-db:5432/account_mart_dev
ACCOUNT_MART_DB_USER=account_mart_dev_app
ACCOUNT_MART_DB_PASSWORD=replace-with-local-app-password
ASSET_LEASE_DB_URL=jdbc:postgresql://postgres-db:5432/asset_lease_dev
ASSET_LEASE_DB_USER=asset_lease_dev_app
ASSET_LEASE_DB_PASSWORD=replace-with-local-app-password
AUTH_DB_URL=jdbc:postgresql://postgres-db:5432/auth_dev
AUTH_DB_USER=auth_dev_app
AUTH_DB_PASSWORD=replace-with-local-app-password
BUDGET_DB_URL=jdbc:postgresql://postgres-db:5432/budget_dev
BUDGET_DB_USER=budget_dev_app
BUDGET_DB_PASSWORD=replace-with-local-app-password
CLOSING_DB_URL=jdbc:postgresql://postgres-db:5432/closing_dev
CLOSING_DB_USER=closing_dev_app
CLOSING_DB_PASSWORD=replace-with-local-app-password
DEPOSIT_DB_URL=jdbc:postgresql://postgres-db:5432/deposit_dev
DEPOSIT_DB_USER=deposit_dev_app
DEPOSIT_DB_PASSWORD=replace-with-local-app-password
ECL_DB_URL=jdbc:postgresql://postgres-db:5432/ecl_dev
ECL_DB_USER=ecl_dev_app
ECL_DB_PASSWORD=replace-with-local-app-password
EXPENDITURE_RESOLUTION_DB_URL=jdbc:postgresql://postgres-db:5432/expenditure_resolution_dev
EXPENDITURE_RESOLUTION_DB_USER=expenditure_resolution_dev_app
EXPENDITURE_RESOLUTION_DB_PASSWORD=replace-with-local-app-password
INTERNAL_AUDIT_DB_URL=jdbc:postgresql://postgres-db:5432/internal_audit_dev
INTERNAL_AUDIT_DB_USER=internal_audit_dev_app
INTERNAL_AUDIT_DB_PASSWORD=replace-with-local-app-password
JOURNAL_LEDGER_DB_URL=jdbc:postgresql://postgres-db:5432/journal_ledger_dev
JOURNAL_LEDGER_DB_USER=journal_ledger_dev_app
JOURNAL_LEDGER_DB_PASSWORD=replace-with-local-app-password
LOAN_DB_URL=jdbc:postgresql://postgres-db:5432/loan_dev
LOAN_DB_USER=loan_dev_app
LOAN_DB_PASSWORD=replace-with-local-app-password
MASTER_DATA_DB_URL=jdbc:postgresql://postgres-db:5432/master_data_dev
MASTER_DATA_DB_USER=master_data_dev_app
MASTER_DATA_DB_PASSWORD=replace-with-local-app-password
PAYABLE_DB_URL=jdbc:postgresql://postgres-db:5432/payable_dev
PAYABLE_DB_USER=payable_dev_app
PAYABLE_DB_PASSWORD=replace-with-local-app-password
RECEIVABLE_DB_URL=jdbc:postgresql://postgres-db:5432/receivable_dev
RECEIVABLE_DB_USER=receivable_dev_app
RECEIVABLE_DB_PASSWORD=replace-with-local-app-password
RECONCILIATION_DB_URL=jdbc:postgresql://postgres-db:5432/reconciliation_dev
RECONCILIATION_DB_USER=reconciliation_dev_app
RECONCILIATION_DB_PASSWORD=replace-with-local-app-password
REPORTING_DB_URL=jdbc:postgresql://postgres-db:5432/reporting_dev
REPORTING_DB_USER=reporting_dev_app
REPORTING_DB_PASSWORD=replace-with-local-app-password
TAX_DB_URL=jdbc:postgresql://postgres-db:5432/tax_dev
TAX_DB_USER=tax_dev_app
TAX_DB_PASSWORD=replace-with-local-app-password
