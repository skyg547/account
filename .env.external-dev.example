# Copy to the ignored `.env.external-dev` file. Never commit real values.
COMPOSE_PROJECT_NAME=account-external-dev
ACCOUNT_NETWORK_NAME=account-external-dev-network
POSTGRES_IMAGE=postgres:16-alpine
DEV_GATEWAY_PORT=8000
DEV_FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api

# Required by Config Server. Populate only through the approved development secret provider.
ENCRYPT_KEY=

# Compatibility variables for the focused postgres/compose.external-dev.yml probe.
DEV_DB_HOST=replace-with-approved-shared-host
DEV_DB_PORT=5432
DEV_DB_NAME=replace-with-bounded-context-database
DEV_DB_USER=replace-with-bounded-context-runtime-role
DEV_DB_PASSWORD=replace-with-secret-provider-value

DEV_KAFKA_BOOTSTRAP_SERVERS=kafka.example.invalid:9092
DEV_REDIS_HOST=redis.example.invalid
DEV_REDIS_PORT=6379

AUTH_JWT_SECRET=replace-with-approved-dev-jwt-secret-at-least-32-characters
AUTH_DEFAULT_PASSWORD=replace-with-approved-dev-auth-bootstrap-password
AUTH_INTERNAL_API_TOKEN=replace-with-approved-dev-internal-token-at-least-32-characters

ACCOUNT_MART_DB_URL=jdbc:postgresql://db.example.invalid:5432/account_mart_dev
ACCOUNT_MART_DB_USER=account_mart_dev_app
ACCOUNT_MART_DB_PASSWORD=replace-with-secret-provider-value
ASSET_LEASE_DB_URL=jdbc:postgresql://db.example.invalid:5432/asset_lease_dev
ASSET_LEASE_DB_USER=asset_lease_dev_app
