# Copy to the ignored `.env.external-dev` file.
# Never commit a real host, username, or password.
COMPOSE_PROJECT_NAME=account-external-dev-db
ACCOUNT_NETWORK_NAME=account-dev-network
POSTGRES_IMAGE=postgres:16-alpine

DEV_DB_HOST=replace-with-approved-shared-host
DEV_DB_PORT=5432
DEV_DB_NAME=replace-with-bounded-context-database
DEV_DB_USER=replace-with-bounded-context-owner
DEV_DB_PASSWORD=replace-with-secret-provider-value
