# ==============================================================================
# [엔터프라이즈 프론트엔드 개발용 Containerfile.dev (Next.js Dev Server)]
# ------------------------------------------------------------------------------
# 💡 교육적 설계 포인트 (Pedagogical Design Notes):
# 1. Node.js LTS Runtime Pinning: node:20-alpine 기반 개발 런타임 통일
# 2. 런타임 정합성 (Runtime Parity): 로컬 개발 및 컨테이너 개발 환경 간 동일 Node 20 LTS 유지
# 3. Lockfile v3 재현성: `npm ci` 기반 의존성 설치로 락파일 변형 방지
# ==============================================================================
FROM node:20-alpine AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS development

WORKDIR /app
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .
RUN mkdir -p /app/.next && chown -R node:node /app

USER node

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
