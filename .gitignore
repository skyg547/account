# Gradle files
.gradle/
build/
bin/
*.class

# IDE files
.idea/
*.iml
*.iws
*.ipr
out/

# Hexagonal architecture uses packages named "port/out".
# Keep IDE build output ignored, but allow source packages that intentionally use this name.
!**/src/main/java/**/port/out/
!**/src/main/java/**/port/out/*.java

